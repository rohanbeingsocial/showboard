{
  "mcpServers": {
    "showboard": {
      "command": "npx",
      "args": ["-y", "showboard@0.4.0", "mcp", "--plugin", "--port", "4711", "--boards", "${CLAUDE_PLUGIN_DATA}/boards"],
      "env": {
        "SHOWBOARD_DATA": "${user_config.data}",
        "SHOWBOARD_DB": "${user_config.database_url}"
      }
    }
  }
}
