{
  "name": "showboard",
  "version": "0.2.0",
  "mcpName": "io.github.rohanbeingsocial/showboard",
  "description": "Your coding agent answers with dashboards, not paragraphs. An MCP server and React components that let Claude Code, Codex, Cursor, Gemini CLI and other agents draw charts and tables from read-only SQL, Excel and CSV, in your browser, your app or a terminal pane.",
  "license": "MIT",
  "homepage": "https://github.com/rohanbeingsocial/showboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohanbeingsocial/showboard.git",
    "directory": "packages/showboard"
  },
  "bugs": {
    "url": "https://github.com/rohanbeingsocial/showboard/issues"
  },
  "type": "module",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "opencode",
    "coding-agent",
    "ai-agent",
    "dashboard",
    "charts",
    "data-visualization",
    "generative-ui",
    "text-to-sql",
    "sql",
    "postgres",
    "sqlite",
    "excel",
    "csv",
    "react",
    "terminal",
    "json-render"
  ],
  "bin": {
    "showboard": "dist/cli/main.js"
  },
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./spec": {
      "types": "./dist/spec/index.d.ts",
      "default": "./dist/spec/index.js"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "default": "./dist/text/index.js"
    },
    "./styles.css": "./dist/react/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/build-viewer.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@json-render/core": "0.21.1",
    "@json-render/react": "0.21.1",
    "pg": "^8.12.0",
    "read-excel-file": "^9.3.12"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
